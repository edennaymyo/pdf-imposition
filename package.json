{
  "name": "repeat-imposition",
  "private": true,
  "version": "0.2.0",
  "description": "Offline PDF step-and-repeat imposition for Duplo finishing workflows.",
  "author": "Nay Myo",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "dev": "vite",
    "build": "vite build",
    "desktop": "npm run build && electron .",
    "desktop:pack": "npm run build && electron-builder --dir",
    "desktop:win": "npm test && npm run build && electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "latest",
    "electron": "^44.1.0",
    "electron-builder": "^26.15.3",
    "lucide-react": "latest",
    "pdf-lib": "latest",
    "pdfjs-dist": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "build": {
    "appId": "com.naymyo.repeatimposition",
    "productName": "Repeat PDF Imposition",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Repeat-PDF-Imposition-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Repeat PDF Imposition"
    }
  }
}
